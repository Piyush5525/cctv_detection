# ============================================================
# DETECTION MODELS -- 1 = ON, 0 = OFF
# ============================================================

VIOLENCE_DETECTION=1
FALL_DETECTION=1
SNATCH_DETECTION=1
FIRE_DETECTION=1
CRASH_DETECTION=1

API_ENABLED=1
LEGACY_DETECTORS_ENABLED=false
DETECT_MAX_WIDTH=640

# Camera / source config
CAMERA_SOURCE=0
CAMERA_ROTATE=0
DETECT_WIDTH=640
# Legacy local loop only (main.py): leave CAMERA_ID unset unless it is a registered camera that is NOT CAM-001.
CAMERA_ID=

# Telegram alerts (get a bot token from @BotFather, chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OMNIDIM voice call alerts
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_FROM_NUMBER_ID=
ALERT_PHONE_NUMBER=

# Dispatch backend -- demo-safe defaults.  A real emergency-service number is
# never dialled: only this explicitly configured demo recipient can be called.
DEMO_MODE=true
DEMO_PHONE_NUMBER=
TELEGRAM_CHAT_ID_ALLOWLIST=
ALERTS_ENABLED=false
SERPAPI_KEY=
MAPBOX_TOKEN=

# Fix pass: shared secret for /demo/*, PATCH and DELETE routes (send as X-Demo-Token).
# Dashboard build reads the same value from frontend/.env as VITE_DEMO_TOKEN.
DEMO_TOKEN=
# API bind address (default localhost only) and demo cooldown
API_HOST=127.0.0.1
DEMO_COOLDOWN_S=15
SAMPLE_CAMERA_WORKERS_ENABLED=false

# Demo phone camera CAM-001 (config/cameras.json references these; values are never stored in the file)
PHONE_CAM001_URL=
PHONE_CAM001_LAT=
PHONE_CAM001_LNG=
# Demo phone camera CAM-002 (same pattern)
PHONE_CAM002_URL=
PHONE_CAM002_LAT=
PHONE_CAM002_LNG=
# Optional: only if the phone app needs a login (kept out of the URL and out of every file/log)
# PHONE_CAM001_USER=
# PHONE_CAM001_PASSWORD=

# Device GPS for demo phones: keep "fixed" (default, no GPS code runs) until scripts/check_phone_gps.py confirms a source
LOCATION_MODE=fixed
# Optional SensorServer WebSocket for a phone, e.g. ws://<phone>:<port>/gps
# PHONE_CAM001_GPS_URL=
# PHONE_CAM002_GPS_URL=
